{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EXP_ASS",
  "version": "0.1.0",
  "identifier": "com.tomy20wang.exp-ass",
  "build": {
    "beforeDevCommand": "npm run ui:dev",
    "beforeBuildCommand": "npm run ui:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EXP_ASS",
        "width": 1120,
        "height": 840,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
